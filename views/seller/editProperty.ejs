<script>
document.addEventListener("DOMContentLoaded", function () {
  const category = document.getElementById("categories");

  const fields = {
    landType: document.getElementById("land-type"),
    areaType: document.getElementById("area-measure"),
    plotArea: document.getElementById("plotarea"),
    facing: document.getElementById("facing"),
    roadwidth: document.getElementById("roadwidth"),
    posession: document.getElementById("posession"),
    totalFloor: document.getElementById("totalfloor"),
    BHK: document.getElementById("BHK"),
    projectname: document.getElementById("projectname"),
    superarea: document.getElementById("superarea"),
    carpetarea: document.getElementById("carpetarea"),
    areaBox: document.querySelector(".area")
  };

  function hideField(el) {
    if (!el) return;

    el.style.display = "none";

    // ❌ disable + remove required from hidden fields (IMPORTANT FIX)
    el.querySelectorAll("input, select, textarea").forEach(input => {
      input.disabled = true;
      input.required = false;
    });
  }

  function showField(el) {
    if (!el) return;

    el.style.display = "block";

    // ✅ enable fields again
    el.querySelectorAll("input, select, textarea").forEach(input => {
      input.disabled = false;
    });
  }

  function hideAll() {
    Object.values(fields).forEach(field => hideField(field));
  }

  function updateForm() {
    hideAll();

    const value = category.value;

    if (value === "plots") {
      showField(fields.plotArea);
      showField(fields.facing);
      showField(fields.roadwidth);
      showField(fields.posession);
    }

    else if (value === "house") {
      showField(fields.plotArea);
      showField(fields.facing);
      showField(fields.roadwidth);
      showField(fields.posession);
      showField(fields.totalFloor);
      showField(fields.BHK);
    }

    else if (value === "flats") {
      showField(fields.facing);
      showField(fields.roadwidth);
      showField(fields.posession);
      showField(fields.projectname);
      showField(fields.superarea);
      showField(fields.carpetarea);
      showField(fields.totalFloor);
      showField(fields.BHK);
    }

    else {
      showField(fields.landType);
      showField(fields.areaType);
      showField(fields.areaBox);
    }
  }

  // initial load
  updateForm();

  // on change
  category.addEventListener("change", updateForm);
});
</script>
