<%- include('../partials/frontend/header') %>
<style>
  select.form-control:not([size]):not([multiple]) {
    height: calc(2.25rem + 20px);
}
</style>
<div class="breadcrumb-area bg-overlay-2" style="background-image:url('/images/baner-image.png')">
  <div class="container">
    <div class="breadcrumb-inner">
      <div class="section-title text-center">
        <h2 class="page-title">Properties</h2>
        <ul class="page-list">
          <li><a href="index.html">Home</a></li>
          <li>Properties</li>
        </ul>
      </div>
    </div>
  </div>
</div>
<!-- breadcrumb end --> 

<div class="blog-page-area pt-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12">
        <!-- Search & Sort -->
       <div class="product-search-inner bg-main">
  <form action="/properties-category" method="get">
    <div class="row custom-gutters-20">

      <div class="col-md-3 align-self-center">
        <!-- <h5>Properties</h5> -->
      </div>

      <div class="col-md-6 mt-2 mt-md-0">
        <input type="hidden" name="category" value="<%= category %>">

        <div class="widget-search">
          <div class="single-search-inner">
            <input
              type="text"
              name="search"
              value="<%= typeof search !== 'undefined' ? search : '' %>"
              placeholder="Search your address"
            >
            <button type="submit">
              <i class="la la-search"></i>
            </button>
          </div>
        </div>
      </div>

      <div class="col-md-3 mt-2 mt-md-0 align-self-center">
        <div class="single-select-inner">
          <select name="sort" class="form-control" onchange="this.form.submit()">
            <option value="">Sort By</option>
            <option value="asc">Price: Low to High</option>
            <option value="desc">Price: High to Low</option>
          </select>
        </div>
      </div>

    </div>
  </form>
</div>
        </div>
      </div>    

      <style>
        .single-product-wrap {
          display: flex;
          flex-direction: column;
          height: 100%;
        }
      .thumb {
  aspect-ratio: 16 / 9;
  overflow: hidden;
}

.thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
        .product-details-inner {
          flex: 1;
          padding: 10px;
          overflow: hidden;
        }
        .product-details-inner p {
          max-height: 60px;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        .cards-property {
          margin-bottom: 20px;
        }
        .single-product-wrap.style-2 .product-meta-bottom span {
          border-left: 1px solid #ececec;
          border-right: 1px solid #ececec;
          display: inline-block;
          margin-right: -4px;
          text-align: center;
          width: 50.33%;
        }
                .price-row{
  display: flex;
  justify-content: space-between;
  align-items: center;
}
      </style>

      <!-- Property Cards -->
      <div class="row d-flex flex-wrap">
        <% properties.forEach(property => { %>  
          <a href="/property-details/<%= property._id %>">  
            <div class="col-lg-4 col-md-6 cards-property" style="cursor: pointer;" onclick="window.location.href='/property-details/<%= property._id %>'">
              <div class="single-product-wrap style-2">
                <div class="thumb">
                  <% if (property.images && property.images.length > 0) { %>
                    <img src="<%= property.images[0] %>" alt="img">
                  <% } else { %>
                    <img src="/frontend/img/banner/1.jpg" alt="img">
                  <% } %>
                  <div class="product-wrap-details">
                    <div class="media">
                      <div class="media-body">
                        <p><%= property.state %></p>
                      </div>
                      <a class="fav-btn float-right" href="#"></a>
                    </div>
                  </div> 
                </div> 

                <div class="product-details-inner">
                  <h4><%= property.address %></h4>
                  <ul class="meta-inner">
                    <li><a href="#">For Sell</a></li>
                  </ul>
                  <p><%= property.description %></p>

                  <% function formatIndianPrice(price) {
                      if (price >= 10000000) {
                        return (price / 10000000).toFixed(price % 10000000 === 0 ? 0 : 2) + ' Crore';
                      } else if (price >= 100000) {
                        return (price / 100000).toFixed(price % 100000 === 0 ? 0 : 2) + ' Lakh';
                      } else {
                        return price.toLocaleString('en-IN');
                      }
                  } %>
                  <div class="price-row">


                    <span class="price">₹ <%= formatIndianPrice(property.price) %></span>
  <% if (property.category === 'land') { %>
  <span>
    ₹ <%= formatIndianPrice(property.price / property.area) %> /
    <%= property.areameasure %>
  </span>
<% } %>
                  </div>

                </div>

                <div class="product-meta-bottom style-2">
                   <% if (property.category == "flats" || property.category == "plots" || property.category == "house") { %>
                      <span><b><%= property.bhk %> BHK</b></span>
                    <% } else { %>
                     <span><b><%= property.LandType %> Land</b></span>
                  <% } %>
                 
                  <span class="border-none"><b><%= property.city %></b> <span>City</span></span>
                </div>         
              </div>
            </div>
          </a>
        <% }); %>
      </div>
       
    
    </div>
  </div>
</div>

<%- include('../partials/frontend/footer') %>
