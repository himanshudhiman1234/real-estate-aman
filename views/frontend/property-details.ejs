<%- include('../partials/frontend/header') %>

<div class="breadcrumb-area bg-overlay-2" style="background-image:url('/images/baner-image.png')">
    <div class="container">
        <div class="breadcrumb-inner">
            <div class="section-title text-center">
                <h2 class="page-title">Property Details</h2>
                <ul class="page-list">
                    <li><a href="index.html">Home</a></li>
                    <li><%= property.title %></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb end --> 

<!-- property-page- Start --> 
<div class="property-page-area pd-top-60 pd-bottom-90">
    <div class="container">
        <div class="property-details-top pd-bottom-70">
            <div class="property-details-top-inner">
                <div class="row">
                    <div class="col-lg-7">
                        <h3><%= property.title %>.</h3>
                        <p><img src="/frontend/img/icon/location2.png" alt="img"> <%= property.address %>. </p>

                    </div>
                    <div class="col-lg-5 text-lg-right">
                         <% function formatIndianPrice(price) {
  if (price >= 10000000) {
    return (price / 10000000).toFixed(price % 10000000 === 0 ? 0 : 2) + ' Crore';
  } else if (price >= 100000) {
    return (price / 100000).toFixed(price % 100000 === 0 ? 0 : 2) + ' Lakh';
  } else {
    return price.toLocaleString('en-IN'); // fallback
  }
} %>

₹ <%= formatIndianPrice(property.price) %>

                    </div>
                </div>
            </div>
            <div class="product-thumbnail-wrapper">
                <div class="single-thumbnail-slider">
                    <% property.images.forEach(property => { %>  
                    <div class="slider-item">
                        <img src="<%= property %>" alt="img">
                    </div>
                    <% }); %>
                   
                </div>
               <div class="product-thumbnail-carousel">
   <% (property.images && property.images.length ? property.images : ['/frontend/img/banner/1.jpg']).forEach(img => { %>
    <div class="single-thumbnail-item">
        <img src="<%= img %>" alt="img">
    </div>
<% }) %>
</div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-8">
                <div class="single-property-details-inner">
                    <h4><%= property.locality %></h4>
                    <p><%= property.description %>.</p>
                     <div class="single-property-grid">
                        <h4>Poperty Details</h4>
                        <div class="row">
                            <div class="col-md-6">
                                <ul>
                                    <li>Land Type: <%= property.LandType %></li>

                                    <% if (property.category == "flats") { %>

<li>Super Area: <%= property.superarea %> Sqft</li>
<li>Carpet Area: <%= property.carpetarea %>< Sqft/li>
<li>Project Name: <%= property.projectname %></li>


                                    <% } %>
                                      <% if (property.category == "flats" || property.category == "house") { %>
                                        <li>BHK: <%= property.bhk %>BHK</li>

                                    <% } %>


                                      <% if (property.category == "flats" || property.category == "plots" || property.category == "house") { %>
                                        <li>Road Width: <%= property.roadwidth %></li>
                                        <li>Posession: <%= property.possession %></li>


                    <% } else { %>
              <li>Area Measure: <%= property.areameasure %></li>
                <li>Area: <%= property.area %></li>

                  <% } %>
                                    
                                    <li>State:  <%= property.state %></li>
                                    <li>Listed By:  <%= property.listed_by %></li>

                                    
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul>

                                      <% if (property.category == "flats" || property.category == "house") { %>
                                        <li>Total Floor: <%= property.totalfloor %></li>
                                
                    <% } %>

                          <% if (property.category == "plots" || property.category == "house") { %>
                                        <li>Total Area: <%= property.plotarea %> <%= property.areaunits %></li>                            
                    <% } %>

                                    <li>City: <%= property.city %> </li>
                                    <li>Address: <%= property.address %></li>
                                    <li>Pincode: <%= property.pincode %></li>
                                    
                                           <% function formatIndianPrice(price) {
  if (price >= 10000000) {
    return (price / 10000000).toFixed(price % 10000000 === 0 ? 0 : 2) + ' Crore';
  } else if (price >= 100000) {
    return (price / 100000).toFixed(price % 100000 === 0 ? 0 : 2) + ' Lakh';
  } else {
    return price.toLocaleString('en-IN'); // fallback
  }
} 
                  const perUnitPrice = property.area > 0 ? property.price / property.area : 0;

%>

<li>Price : ₹ <%= formatIndianPrice(property.price) %></li>

                                    <!-- <li>Price: <%= property.price %></li> -->
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="sidebar-area">
                    <div class="widget widget-author text-center">
                        <h4 class="widget-title">About Seller</h4>
                        <div class="details">
                            <h5> <%= property.sellerName %></h5>
                            <p>Phone Number:+91-xxxxxxxxxx</p>
                            <p>Email:xxxx@xxxx.com</p>

                            <!-- <ul>
                                <li><a href="#"><i class="fab fa-facebook-f" aria-hidden="true"></i></a></li>
                                <li><a href="#"><i class="fab fa-linkedin-in" aria-hidden="true"></i></a></li>
                                <li><a href="#"><i class="fab fa-instagram" aria-hidden="true"></i></a></li>
                                <li><a href="#"><i class="fab fa-twitter" aria-hidden="true"></i></a></li>
                            </ul> -->
                        </div>
                    <div class="detail">
  <form id="callbackForm" action="/property/<%= property._id %>/request-callback" method="POST">
    <button type="submit" class="callback-btn">Request a Callback</button>
  </form>
</div>

<script>
document.getElementById('callbackForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = this.querySelector('.callback-btn');
  btn.disabled = true;
  btn.textContent = 'Sending...';

  const res = await fetch(this.action, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  });
  const data = await res.json();

  if (data.success) {
    alert('The seller will contact you shortly to discuss the property details.');
  } else {
    alert('Something went wrong. Please try again.');
  }

  btn.disabled = false;
  btn.textContent = 'Request a Callback';
});
</script>


                </aside>
            </div>
        </div>
    </div>
</div>

<style>
.detail {
  text-align: center;
  margin-top: 40px;
}

.callback-btn {
  display: inline-block;
  padding: 12px 28px;
  background: linear-gradient(135deg, #5ba600, #5ba600);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 50px;
  box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
}

.callback-btn:hover {
  background: linear-gradient(135deg, #5ba600, #5ba600);
  box-shadow: 0 6px 16px rgba(0, 122, 255, 0.5);
  color: #fff;
  transform: translateY(-2px);
}

.callback-btn:active {
  transform: translateY(0);
  box-shadow: 0 3px 8px rgba(0, 122, 255, 0.4);
}
</style>
<%- include('../partials/frontend/footer') %>